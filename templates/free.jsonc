{
  "$schema": "https://opencode.ai/config.json",
  // opencode-free-router: loaded via OPENCODE_CONFIG by the `opencode-free` wrapper (and the bb agent),
  // merged over your normal opencode config, so plain `opencode` is unaffected. Needs opencode 2.
  // free/auto uses the best generally ranked free model. free/nix uses only a model with a NixBench
  // screening result. Both stay sticky per session and fail over within their own ranking.
  "plugins": ["./plugin"],
  "model": "free/auto",
  "providers": {
    // Never called: the dead baseURL makes a missed switch fail fast instead of
    // silently landing on some other (possibly paid) model.
    "free": {
      "name": "Free (auto-ranked)",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9/v1",
        "apiKey": "unused"
      },
      "models": {
        "auto": {
          "name": "Best available free model",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "nix": {
          "name": "Best NixBench-screened free model",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  }
}
